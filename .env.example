# Documentation only: Python does not automatically load this file.
AI_PROVIDERS=gemini
AI_DAILY_USD=0
AI_MAX_RUN_CALLS=20
AI_MAX_INPUT_BYTES=262144
AI_MAX_OUTPUT_TOKENS=4096
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRY_SECONDS=15

GEMINI_API_KEY=
AI_GEMINI_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest
# Set true only after checking this key's project is Free Tier with no billing.
AI_GEMINI_FREE_TIER_CONFIRMED=false
AI_GEMINI_DAILY_CALLS=20
AI_GEMINI_MIN_INTERVAL_MS=5000

# Optional fallback: configure only current, schema-capable :free models.
OPENROUTER_API_KEY=
AI_OPENROUTER_MODELS=
AI_OPENROUTER_FREE_TIER_CONFIRMED=false
AI_OPENROUTER_DAILY_CALLS=20
AI_OPENROUTER_MIN_INTERVAL_MS=5000
